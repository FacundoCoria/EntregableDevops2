{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "l4-07-containers-root",
    "namespace": "laboratorio4"
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "test",
        "image": "pedidos-api:l4-01",
        "imagePullPolicy": "Never",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "runAsNonRoot": false,
          "runAsUser": 0,
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      }
    ]
  }
}