{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "l4-07-override-false",
    "namespace": "laboratorio4"
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "test",
        "image": "pedidos-api:l4-01",
        "imagePullPolicy": "Never",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "runAsNonRoot": false
        }
      }
    ],
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 10001
    }
  }
}