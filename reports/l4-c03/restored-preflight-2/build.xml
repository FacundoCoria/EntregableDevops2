                        echo PERSISTENCE_CREATED | tee evidence/persistence.txt
                    fi
                &apos;&apos;&apos;
            }
        }
    }
    post { always { archiveArtifacts artifacts: &apos;evidence/**&apos;, allowEmptyArchive: true } }
}
