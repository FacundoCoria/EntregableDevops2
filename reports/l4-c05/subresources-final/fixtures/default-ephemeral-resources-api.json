{
  "spec": {
    "ephemeralContainers": [
      {
        "name": "debug-resources",
        "image": "busybox:1.36",
        "imagePullPolicy": "Never",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001
        }
      }
    ]
  }
}