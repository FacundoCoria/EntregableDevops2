{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "c05-sidecar-port-no-tag",
    "namespace": "laboratorio4"
  },
  "spec": {
    "nodeName": "c05-no-execution",
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "main",
        "image": "busybox:1.36",
        "imagePullPolicy": "Never",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001
        }
      }
    ],
    "initContainers": [
      {
        "name": "init",
        "image": "registry.example:5000/busybox",
        "imagePullPolicy": "Never",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001
        },
        "restartPolicy": "Always"
      }
    ]
  }
}