{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "c05-containers-repo-named-latest",
    "namespace": "laboratorio4"
  },
  "spec": {
    "nodeName": "c05-no-execution",
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "main",
        "image": "registry.example/latest@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "imagePullPolicy": "Never",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001
        }
      }
    ]
  }
}