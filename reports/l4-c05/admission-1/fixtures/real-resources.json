{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "c05-real-resources",
    "namespace": "default"
  },
  "spec": {
    "nodeName": "c05-no-execution",
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "main",
        "image": "busybox:1.36",
        "imagePullPolicy": "Never",
        "resources": {},
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001
        }
      }
    ]
  }
}