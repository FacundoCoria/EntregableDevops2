ARG DOCKER_CLI_BASE
ARG JENKINS_BASE
FROM ${DOCKER_CLI_BASE} AS docker-cli
FROM ${JENKINS_BASE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/l4-tools /var/jenkins_home \
    && chown -R jenkins:jenkins /opt/l4-tools /var/jenkins_home
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY ci/bootstrap-tools.sh /opt/l4/bootstrap-tools.sh
COPY ci/jenkins/agent-entrypoint.sh /opt/l4/agent-entrypoint.sh
USER 1000:1000
ENV L4_TOOLS_ROOT=/opt/l4-tools
ENV PATH=/opt/l4-tools/bin:$PATH
RUN sh /opt/l4/bootstrap-tools.sh
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY ci/jenkins/test-versions.sh /opt/l4/test-versions.sh
ENTRYPOINT ["sh", "/opt/l4/agent-entrypoint.sh"]
