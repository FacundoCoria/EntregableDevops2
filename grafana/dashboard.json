{
  "id": null,
  "uid": "l4-observabilidad",
  "title": "Laboratorio 4 - Observabilidad",
  "tags": [
    "laboratorio4",
    "pedidos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "constant",
        "query": "laboratorio4",
        "current": {
          "text": "laboratorio4",
          "value": "laboratorio4"
        },
        "hide": 0
      },
      {
        "name": "release",
        "label": "Release",
        "type": "constant",
        "query": "l4",
        "current": {
          "text": "l4",
          "value": "l4"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Solicitudes HTTP por segundo",
      "description": "Solo rutas /api/*; excluye sondas y scrapes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "l4-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "l4-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"pedidos-api\",namespace=\"$namespace\",release=\"$release\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "API",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia HTTP promedio",
      "description": "Tiempo de respuesta HTTP ponderado por solicitud. Sin tráfico puede no haber valor; no son minutos de espera del pedido.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "l4-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "l4-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"pedidos-api\",namespace=\"$namespace\",release=\"$release\",uri=~\"/api/.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"pedidos-api\",namespace=\"$namespace\",release=\"$release\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "Promedio",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU por pod",
      "description": "CPU del pod completo informada por kubelet, en núcleos. 1 equivale a un núcleo ocupado.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "l4-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "l4-prometheus"
          },
          "expr": "sum by (pod) (rate(pod_cpu_usage_seconds_total{job=\"kubelet-resource\",namespace=\"$namespace\",pod=~\"${release}-pedidos-.*\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Memoria por pod",
      "description": "Working set del pod completo, no solo heap JVM.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "l4-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "l4-prometheus"
          },
          "expr": "sum by (pod) (pod_memory_working_set_bytes{job=\"kubelet-resource\",namespace=\"$namespace\",pod=~\"${release}-pedidos-.*\"})",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Pedidos creados por producto",
      "description": "Contador de pedidos creados desde el arranque del proceso. Se reinicia con la API; no representa un total histórico de H2.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "l4-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "l4-prometheus"
          },
          "expr": "sum by (producto) (pedidos_creados_total{job=\"pedidos-api\",namespace=\"$namespace\",release=\"$release\"})",
          "legendFormat": "{{producto}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Pedidos creados por segundo",
      "description": "Tasa de creación por producto; rate contempla reinicios del contador.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "l4-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "l4-prometheus"
          },
          "expr": "sum by (producto) (rate(pedidos_creados_total{job=\"pedidos-api\",namespace=\"$namespace\",release=\"$release\"}[$__rate_interval]))",
          "legendFormat": "{{producto}}",
          "range": true
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  }
}
